---
import Layout from "../layouts/Layout.astro";
import datos from "../datos/nosotros.json";
const { meta, cabecera, introduccion, introduccionCta, titulos, mision, vision, historia, valores, normas, foto } = datos;
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion} activa="nosotros">
  <header class="cabecera-pagina">
    <div class="container">
      <span class="eyebrow"><span class="dot"></span> {cabecera.encabezado}</span>
      <h1>{cabecera.titulo}</h1>
      <p class="lead">{cabecera.texto}</p>
    </div>
  </header>

  <section class="pad">
    <div class="container nosotros-grid">
      <div class="reveal-left">
        <p class="lead medida-lectura">{introduccion}</p>
        <div class="cta-block" style="justify-content:flex-start">
          <a href={introduccionCta.href} class={`btn ${introduccionCta.estilo}`}>{introduccionCta.texto}</a>
        </div>
      </div>
      <div class="nosotros-visual reveal-right" data-parallax="0.05">
        <img src={foto.src} alt={foto.alt} width="1600" height="900" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <section class="pad" style="background:var(--bg-soft)">
    <div class="container dos-col" data-stagger>
      <article class="bloque-texto reveal-up">
        <h2>{titulos.mision}</h2>
        <p>{mision}</p>
      </article>
      <article class="bloque-texto reveal-up">
        <h2>{titulos.vision}</h2>
        <p>{vision}</p>
      </article>
    </div>
  </section>

  <section class="pad">
    <div class="container">
      <article class="bloque-texto reveal">
        <h2>{titulos.historia}</h2>
        <p>{historia}</p>
      </article>
    </div>
  </section>

  <section class="pad" style="background:var(--bg-soft)">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> {valores.eyebrow}</span>
      <h2 class="section-title reveal">{valores.titulo}</h2>
      <p class="lead medida-lectura reveal">{valores.texto}</p>

      <div class="grid-valores" data-stagger>
        {valores.items.map((v) => (
          <article class="bloque-texto reveal-up" style="box-shadow:none">
            <span class="servicio-ico"><i data-lucide={v.icono}></i></span>
            <h2 style="font-size:1.12rem;margin-top:16px">{v.titulo}</h2>
            <p style="font-size:.96rem">{v.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pad">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> {normas.eyebrow}</span>
      <h2 class="section-title reveal">{normas.titulo}</h2>
      <p class="lead medida-lectura reveal">{normas.texto}</p>
      <div class="confianza-inner" data-stagger style="justify-content:flex-start;padding-top:26px">
        {normas.items.map((n) => (
          <span class="reveal-pop sello-norma">{n}</span>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
.sello-norma {
  font-family: var(--font-display); font-weight: 700; font-size: 1rem;
  padding: 12px 22px; border-radius: 12px;
  border: 1px solid var(--border-strong); color: var(--text);
  background: var(--surface); letter-spacing: .04em;
}
</style>
