---
/**
 * Página de inicio — IMMA.
 * REGLA: aquí NO se escribe texto. Todo sale de src/datos/inicio.json.
 */
import Layout from "../layouts/Layout.astro";
import datos from "../datos/inicio.json";
import sitio from "../datos/sitio.json";
import { leerPosts } from "../lib/posts";

const { portada, servicios, nosotros, cifras, faq, contacto, confianza, meta, metodos, blog } = datos;
const ultimoPost = leerPosts()[0];
const wa = `https://wa.me/${sitio.whatsapp}`;
const enlace = (href: string) => (href === "whatsapp" ? wa : href);
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion} activa="inicio">
  {/* ==================== PORTADA ==================== */}
  <header class="portada">
    <div class="container portada-grid">
      <div>
        <span class="eyebrow reveal"><span class="dot"></span> {portada.encabezado}</span>
        <h1 class="reveal">{portada.titulo}</h1>
        <p class="lead reveal">{portada.texto}</p>
        <div class="portada-botones reveal">
          {portada.botones.map((b) => {
            const href = enlace(b.href);
            const externo = href.startsWith("http");
            return (
              <a href={href} target={externo ? "_blank" : "_self"} rel={externo ? "noopener" : undefined} class={`btn ${b.estilo}`}>
                {b.texto}
              </a>
            );
          })}
        </div>
      </div>
      <div class="portada-visual reveal" data-parallax="0.06">
        <img src={portada.imagen} alt={portada.imagenAlt} width="1600" height="750" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </header>

  {/* ==================== BANDA DE CONFIANZA ==================== */}
  <div class="confianza">
    <div class="container confianza-inner" data-stagger>
      {confianza.items.map((c, i) => (
        <>
          {i > 0 && <span class="confianza-sep" aria-hidden="true"></span>}
          <span class="confianza-item reveal-up">
            <i data-lucide={c.icono}></i>
            {c.texto}
          </span>
        </>
      ))}
    </div>
  </div>

  {/* ==================== SERVICIOS ==================== */}
  <section class="pad" id="servicios">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> {servicios.encabezado}</span>
      <h2 class="section-title reveal">{servicios.titulo}</h2>
      <p class="lead medida-lectura reveal">{servicios.texto}</p>

      <div class="grid-servicios" data-stagger>
        {servicios.items.map((s) => (
          <article class="servicio reveal-up">
            <div class="servicio-foto">
              <img src={s.imagen} alt="" width="700" height="438" loading="lazy" decoding="async" />
            </div>
            <div class="servicio-cuerpo">
              <span class="servicio-ico"><i data-lucide={s.icono}></i></span>
              <h3>{s.titulo}</h3>
              <p>{s.texto}</p>
              <a class="link-detalle" href={`/servicios#${s.id}`}>
                {servicios.enlaceTexto} <i data-lucide="arrow-right"></i>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== NOSOTROS ==================== */}
  <section class="pad" id="nosotros" style="background:var(--bg-soft)">
    <div class="container nosotros-grid">
      <div class="reveal-left">
        <span class="eyebrow"><span class="dot"></span> {nosotros.encabezado}</span>
        <h2 class="section-title">{nosotros.titulo}</h2>
        <p class="lead">{nosotros.texto}</p>
        <div class="cta-block" style="justify-content:flex-start">
          <a href={nosotros.boton.href} class={`btn ${nosotros.boton.estilo}`}>{nosotros.boton.texto}</a>
        </div>
      </div>
      <div class="nosotros-visual reveal-right" data-parallax="0.05">
        <img src={nosotros.imagen} alt={nosotros.imagenAlt} width="1600" height="900" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  {/* ==================== MÉTODOS END ==================== */}
  <section class="pad metodos" id="metodos">
    <div class="container metodos-grid">
      <div class="reveal-left">
        <span class="eyebrow"><span class="dot"></span> {metodos.encabezado}</span>
        <h2 class="section-title">{metodos.titulo}</h2>
        <p class="lead">{metodos.texto}</p>
        <div class="metodos-foto">
          <img src={metodos.imagen} alt={metodos.imagenAlt} width="1024" height="488" loading="lazy" decoding="async" />
        </div>
        <div class="cta-block" style="justify-content:flex-start">
          <a href={metodos.boton.href} class={`btn ${metodos.boton.estilo}`}>{metodos.boton.texto}</a>
        </div>
      </div>
      <div class="metodos-lista" data-stagger>
        {metodos.grupos.map((g) => (
          <article class="metodo-grupo reveal-up">
            <span class="servicio-ico"><i data-lucide={g.icono}></i></span>
            <div>
              <h3>{g.titulo}</h3>
              <p>{g.texto}</p>
              <ul class="chips">
                {g.items.map((m) => <li>{m}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== CIFRAS ==================== */}
  <section class="pad cifras">
    <div class="container grid-cifras" data-stagger>
      {cifras.items.map((c) => (
        <div class="reveal-pop">
          <i data-lucide={c.icono}></i>
          <div class="cifra-num" data-contar={c.numero} data-sufijo={c.sufijo}>0</div>
          <p>{c.texto}</p>
        </div>
      ))}
    </div>
  </section>

  {/* ==================== BLOG ==================== */}
  {ultimoPost && (
    <section class="pad" id="blog" style="background:var(--bg-soft)">
      <div class="container">
        <span class="eyebrow reveal"><span class="dot"></span> {blog.encabezado}</span>
        <h2 class="section-title reveal">{blog.titulo}</h2>
        <p class="lead medida-lectura reveal">{blog.texto}</p>
        <a class="post-destacado card reveal" href={`/blog/${ultimoPost.slug}`}>
          {ultimoPost.imagen && (
            <div class="post-destacado-foto">
              <img src={ultimoPost.imagen} alt="" width="1024" height="488" loading="lazy" decoding="async" />
            </div>
          )}
          <div class="post-destacado-cuerpo">
            <span class="post-fecha">{ultimoPost.fecha}</span>
            <h3>{ultimoPost.titulo}</h3>
            <p>{ultimoPost.extracto}</p>
            <span class="post-link">{blog.leer} <i data-lucide="arrow-right"></i></span>
          </div>
        </a>
        <div class="cta-block reveal" style="justify-content:flex-start">
          <a href={blog.href} class="btn btn-ghost">{blog.todos}</a>
        </div>
      </div>
    </section>
  )}

  {/* ==================== PREGUNTAS FRECUENTES ==================== */}
  <section class="pad" id="faq">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> {faq.encabezado}</span>
      <h2 class="section-title reveal">{faq.titulo}</h2>

      <div class="lista-faq" data-stagger>
        {faq.items.map((f) => (
          <details class="card reveal-up">
            <summary>{f.pregunta}</summary>
            <p>{f.respuesta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== CONTACTO ==================== */}
  <section class="pad banda-contacto" id="contacto">
    <div class="container banda-contacto-inner">
      <div>
        <span class="eyebrow reveal"><span class="dot"></span> {contacto.encabezado}</span>
        <h2 class="section-title reveal">{contacto.titulo}</h2>
        <p class="lead medida-lectura reveal">{contacto.texto}</p>
        <div class="cta-block reveal" style="justify-content:flex-start">
          {contacto.botones.map((b) => {
            const href = enlace(b.href);
            const externo = href.startsWith("http");
            return (
              <a href={href} target={externo ? "_blank" : "_self"} rel={externo ? "noopener" : undefined} class={`btn ${b.estilo}`}>
                {b.texto}
              </a>
            );
          })}
        </div>
      </div>
      <ul class="banda-datos reveal">
        <li><i data-lucide="phone"></i><div><small>{contacto.telefonoEtiqueta}</small><strong>{sitio.whatsappTexto}</strong></div></li>
        <li><i data-lucide="clock"></i><div><small>{contacto.horarioEtiqueta}</small><strong>{sitio.horario}</strong></div></li>
        <li><i data-lucide="map-pin"></i><div><small>{contacto.direccionEtiqueta}</small><strong>{sitio.direccion}</strong></div></li>
      </ul>
    </div>
  </section>
</Layout>

<script is:inline>
  /* Contadores: de 0 al valor final al entrar en pantalla.
     Red de seguridad: si la pestaña queda en segundo plano, el rAF se
     estrangula — se escribe el valor final igual. */
  (function () {
    const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const nums = Array.from(document.querySelectorAll("[data-contar]"));
    if (!nums.length) return;

    const pintar = (el) => {
      const destino = parseInt(el.dataset.contar, 10) || 0;
      const sufijo = el.dataset.sufijo || "";
      const escribir = (v) => { el.textContent = v + sufijo; };
      if (menosMovimiento || document.hidden) { escribir(destino); return; }
      const inicio = performance.now();
      const paso = (ahora) => {
        const t = Math.min((ahora - inicio) / 1400, 1);
        escribir(Math.round(destino * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
      setTimeout(() => escribir(destino), 1800);
    };

    if (!("IntersectionObserver" in window)) { nums.forEach(pintar); return; }
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) { pintar(e.target); io.unobserve(e.target); } });
    }, { threshold: 0.5 });
    nums.forEach((n) => io.observe(n));
  })();
</script>
