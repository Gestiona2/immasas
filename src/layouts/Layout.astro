---
/**
 * Layout base — lo que se repite en todas las páginas.
 * Menú, pie, botón de tema, aparición al bajar, volver arriba.
 *
 * El contenido de cada página NO se escribe aquí: vive en src/datos/.
 */
import "../styles/global.css";
import sitio from "../datos/sitio.json";
import servicios from "../datos/servicios.json";

interface Props {
  titulo: string;
  descripcion?: string;
  activa?: string;
  imagen?: string;
}
const { titulo, descripcion = sitio.descripcion, activa = "", imagen = "/img/og-imma.jpg" } = Astro.props;

/* URLs absolutas: las redes sociales y los buscadores no resuelven rutas relativas. */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const origen = Astro.site ?? new URL(sitio.url);
const canonica = new URL(Astro.url.pathname, origen).href;
const imagenAbs = new URL(base + imagen, origen).href;

const datosEstructurados = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: sitio.razonSocial,
  alternateName: sitio.nombre,
  url: new URL(base + "/", origen).href,
  logo: new URL(base + "/brand/logo@2x.png", origen).href,
  description: sitio.descripcion,
  telephone: `+${sitio.whatsapp}`,
  address: { "@type": "PostalAddress", streetAddress: sitio.direccionCalle, addressLocality: sitio.ciudad, addressRegion: sitio.departamento, addressCountry: "CO" },
  openingHours: ["Mo-Fr 08:00-18:00", "Sa 08:00-12:00"],
  areaServed: "CO",
  makesOffer: servicios.servicios.map((s) => ({
    "@type": "Offer",
    itemOffered: { "@type": "Service", name: s.titulo, description: s.texto },
  })),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/brand/favicon.png" />
    <link rel="apple-touch-icon" href="/brand/favicon.png" />
    <meta name="theme-color" content="#9c1822" />
    <link rel="canonical" href={canonica} />
    {sitio.indexar === false
      ? <meta name="robots" content="noindex, nofollow" />
      : <link rel="sitemap" href="/sitemap.xml" />}

    <!-- Redes sociales -->
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={sitio.razonSocial} />
    <meta property="og:image" content={imagenAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenAbs} />

    <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />

    <!--
      Evita el parpadeo de tema incorrecto.
      Va ANTES de que se pinte nada: si se mueve más abajo, el visitante
      ve un destello blanco al entrar con tema oscuro.
    -->
    <script is:inline define:vars={{ clave: sitio.claveTema }}>
      (function () {
        try {
          document.documentElement.setAttribute(
            "data-theme",
            localStorage.getItem(clave) || "light"
          );
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>

  <body>
    <a class="salto-contenido" href="#contenido">{sitio.accesibilidad.saltarContenido}</a>

    <!-- ==================== MENÚ ==================== -->
    <header class="nav" id="nav">
      <div class="container nav-inner">
        <a href="/" class="nav-logo" aria-label={`${sitio.nombre} — inicio`}>
          <img data-logo="rojo" src="/brand/logo.png" alt={sitio.nombre} width="450" height="177" />
          <img data-logo="blanco" src="/brand/logo-blanco.png" alt="" aria-hidden="true" width="450" height="177" />
        </a>

        <nav class="nav-links" id="navLinks" aria-label={sitio.accesibilidad.menuPrincipal}>
          {sitio.menu.map((item) => (
            <a href={item.href} class={activa === item.id ? "activo" : ""}>{item.texto}</a>
          ))}
          <a class="nav-wa-movil btn btn-primary" href={sitio.ctaPrincipal.href} target="_blank" rel="noopener">{sitio.ctaPrincipal.texto}</a>
        </nav>

        <div class="nav-actions">
          <button id="botonTema" aria-label={sitio.accesibilidad.tema}></button>
          <a href={sitio.ctaPrincipal.href} target="_blank" rel="noopener" class="btn btn-primary nav-cta">{sitio.ctaPrincipal.texto}</a>
          <button id="botonMenu" aria-label={sitio.accesibilidad.abrirMenu} aria-expanded="false"><i data-lucide="menu"></i></button>
        </div>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <!-- ==================== PIE ==================== -->
    <footer class="pie">
      <div class="container">
        <div class="pie-grid">
          <div class="pie-col-marca">
            <div class="pie-marca">
              <img src="/brand/logo-blanco.png" alt={sitio.nombre} width="450" height="177" loading="lazy" />
            </div>
            <p style="max-width:44ch">{sitio.descripcion}</p>
            <a class="btn btn-primary pie-cta" href={sitio.ctaPrincipal.href} target="_blank" rel="noopener">
              <i data-lucide="message-circle"></i>{sitio.pie.cta}
            </a>
          </div>

          <nav class="pie-col" aria-label={sitio.pie.serviciosTitulo}>
            <h2>{sitio.pie.serviciosTitulo}</h2>
            <ul>
              {servicios.servicios.map((s) => (
                <li><a href={`/servicios#${s.id}`}>{s.titulo}</a></li>
              ))}
            </ul>
          </nav>

          <nav class="pie-col" aria-label={sitio.pie.paginasTitulo}>
            <h2>{sitio.pie.paginasTitulo}</h2>
            <ul>
              {sitio.menu.map((item) => <li><a href={item.href}>{item.texto}</a></li>)}
            </ul>
          </nav>

          <div class="pie-col">
            <h2>{sitio.pie.contactoTitulo}</h2>
            <ul class="pie-contacto">
              <li><i data-lucide="map-pin"></i><span>{sitio.direccion} · <a href={sitio.mapaUrl} target="_blank" rel="noopener">{sitio.comoLlegar}</a></span></li>
              <li><i data-lucide="clock"></i><span>{sitio.horario}</span></li>
              <li><i data-lucide="phone"></i><a href={`https://wa.me/${sitio.whatsapp}`} target="_blank" rel="noopener">{sitio.whatsappTexto}</a></li>
            </ul>
          </div>
        </div>

        <div class="pie-legal">
          <span>&copy; {new Date().getFullYear()} {sitio.razonSocial}. Todos los derechos reservados.</span>
          <span>{sitio.descripcionCorta}</span>
        </div>
      </div>
    </footer>

    <a
      href={`https://wa.me/${sitio.whatsapp}`}
      class="flota-wa"
      target="_blank"
      rel="noopener"
      aria-label={sitio.accesibilidad.whatsapp}
    >
      <i data-lucide="message-circle"></i>
    </a>
    <button class="volver-arriba" id="volverArriba" aria-label={sitio.accesibilidad.volverArriba}>
      <i data-lucide="arrow-up"></i>
    </button>

    <!--
      Librerías guardadas dentro del sitio, no desde servidores ajenos.
      Privacidad + longevidad. Ver conocimiento/politicas.md.
    -->
    <script is:inline src="/vendor/lucide/lucide.min.js"></script>
    <script is:inline src="/vendor/gsap/gsap.min.js"></script>
    <script is:inline src="/vendor/gsap/ScrollTrigger.min.js"></script>

    <script is:inline define:vars={{ clave: sitio.claveTema, etiq: sitio.accesibilidad }}>
      const $ = (s) => document.querySelector(s);
      const $$ = (s) => Array.from(document.querySelectorAll(s));
      const raiz = document.documentElement;
      const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (window.lucide) lucide.createIcons();

      /* ---------- Tema claro / oscuro ---------- */
      const botonTema = $("#botonTema");
      const pintarBotonTema = () => {
        botonTema.innerHTML =
          raiz.getAttribute("data-theme") === "dark"
            ? '<i data-lucide="sun"></i>'
            : '<i data-lucide="moon"></i>';
        if (window.lucide) lucide.createIcons();
      };
      botonTema?.addEventListener("click", () => {
        const siguiente = raiz.getAttribute("data-theme") === "dark" ? "light" : "dark";
        raiz.setAttribute("data-theme", siguiente);
        try { localStorage.setItem(clave, siguiente); } catch (e) {}
        pintarBotonTema();
      });
      pintarBotonTema();

      /* ---------- Menú en celular ---------- */
      const botonMenu = $("#botonMenu");
      const pintarBotonMenu = (abierto) => {
        botonMenu.innerHTML = `<i data-lucide="${abierto ? "x" : "menu"}"></i>`;
        botonMenu.setAttribute("aria-label", abierto ? etiq.cerrarMenu : etiq.abrirMenu);
        if (window.lucide) lucide.createIcons();
      };
      botonMenu?.addEventListener("click", () => {
        const abierto = $("#navLinks").classList.toggle("abierto");
        botonMenu.setAttribute("aria-expanded", String(abierto));
        pintarBotonMenu(abierto);
        // Con el menú abierto el nav siempre lleva fondo: si no, el panel
        // queda sobre la portada oscura y los enlaces se pierden.
        if (abierto) nav.classList.add("bajado");
        else alBajar();
      });

      /* ---------- Apariciones al bajar, con GSAP ---------- */
      if (window.gsap && window.ScrollTrigger && !menosMovimiento) {
        gsap.registerPlugin(ScrollTrigger);
        $$(".reveal").forEach((el) =>
          gsap.to(el, {
            opacity: 1, y: 0, duration: 0.9, ease: "power3.out",
            scrollTrigger: { trigger: el, start: "top 88%" },
          })
        );
        // Parallax suave: data-parallax="0.08" (valores altos marean)
        $$("[data-parallax]").forEach((el) => {
          gsap.to(el, {
            yPercent: -parseFloat(el.dataset.parallax) * 100, ease: "none",
            scrollTrigger: { trigger: el, start: "top bottom", end: "bottom top", scrub: true },
          });
        });
      } else {
        // Sin GSAP o con movimiento reducido: mostrar todo de una vez.
        $$(".reveal").forEach((el) => { el.style.opacity = 1; el.style.transform = "none"; });
      }

      /* ---------- Apariciones en CSS puro ---------- */
      const apariciones = $$(".reveal-up, .reveal-left, .reveal-right, .reveal-pop");
      // Retraso escalonado dentro de un grupo con data-stagger
      $$("[data-stagger]").forEach((grupo) => {
        Array.from(grupo.children).forEach((hijo, i) => hijo.style.setProperty("--i", i));
      });

      if (menosMovimiento || !("IntersectionObserver" in window)) {
        apariciones.forEach((el) => el.classList.add("seen"));
      } else {
        const observador = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((entrada) => {
              if (entrada.isIntersecting) {
                entrada.target.classList.add("seen");
                observador.unobserve(entrada.target);
              }
            });
          },
          { threshold: 0.18, rootMargin: "0px 0px -8% 0px" }
        );
        apariciones.forEach((el) => observador.observe(el));
      }

      /* ---------- Menú con fondo al bajar + volver arriba ---------- */
      const nav = $("#nav");
      const volverArriba = $("#volverArriba");
      const alBajar = () => {
        nav.classList.toggle("bajado", window.scrollY > 20);
        volverArriba.classList.toggle("visible", window.scrollY > 600);
      };
      window.addEventListener("scroll", alBajar, { passive: true });
      alBajar();
      volverArriba?.addEventListener("click", () =>
        window.scrollTo({ top: 0, behavior: menosMovimiento ? "auto" : "smooth" })
      );
    </script>
  </body>
</html>
